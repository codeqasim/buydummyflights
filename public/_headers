# STATIC ASSET CACHING (SERVED BY WORKERS STATIC ASSETS, NOT THE WORKER). ?v=<hash> URLS ARE IMMUTABLE; THE REST REVALIDATE.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
/assets/images/*
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=86400
/favicon.ico
  Cache-Control: public, max-age=86400
/site.webmanifest
  Cache-Control: public, max-age=86400
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
